# ==============================================================================
# LastKey v0.2 — Environment Configuration Template (.env.example)
# Salin file ini menjadi .env dan ganti seluruh placeholder sebelum menjalankan aplikasi.
# JANGAN commit file .env atau nilai secret asli ke repository Git.
# ==============================================================================

# 1. Koneksi PostgreSQL (Prisma ORM 7)
DATABASE_URL="postgresql://POSTGRES_USER:POSTGRES_PASSWORD@localhost:5432/lastkey?schema=public"

# 2. Kunci Enkripsi AES-256-GCM Server-Only (Wajib 32 byte / 256-bit dalam Base64)
# Bangkitkan dengan perintah:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# PENTING: Jangan gunakan prefix NEXT_PUBLIC_ agar kunci tidak pernah terekspos ke browser.
LASTKEY_ENCRYPTION_KEY_BASE64="GANTI_DENGAN_BASE64_32_BYTE_DARI_CSPRNG"

# 3. Secret Session HMAC Server-Only (Minimal 32 byte hex/base64 dari CSPRNG)
# Bangkitkan dengan perintah:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LASTKEY_SESSION_SECRET="GANTI_DENGAN_HEX_SECRET_MINIMAL_32_BYTE"

# 4. Password Sintetis untuk Akun Uji pada Prisma Seed (Hanya untuk pengujian lokal)
# Digunakan oleh prisma/seed.ts untuk membuat hash bcrypt tanpa menyimpan password plaintext di Git.
LASTKEY_SEED_PASSWORD="GANTI_DENGAN_PASSWORD_UJI_SINTETIS"

